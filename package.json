{
  "name": "agent-skills-manager",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "lint": "bunx eslint src/",
    "build": "bun build src/cli.ts --compile --outfile dist/asm",
    "link": "ln -sf $(pwd)/dist/asm /usr/local/bin/asm"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/bun": "^1.2.10",
    "eslint": "^9.25.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
